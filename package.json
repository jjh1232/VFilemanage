{
  "name": "react-parcel",
  "productName": "VFilemanage",
  "version": "1.0.0",
  "main": "main.js",
  "targets": {
    "main": false
  },
  "scripts": {
    "rebuild-addon": "powershell -Command \"cd addon; node-gyp clean; node-gyp rebuild\"",
    "start": "parcel index.html --dist-dir .devdist",
    "build-addon": "cd addon && node-gyp rebuild",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && parcel build index.html --public-url ./ --no-source-maps",
    "dist": "npm run build && electron-builder",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:1234 && electron . --dev\"",
    "electron": "electron ."
  },
  "keywords": [],
  "author": "jjh1232",
  "license": "ISC",
  "description": "원본을 옮기지 않고 가상 폴더트리로 파일을 정리하는 파일 관리자",
  "build": {
    "appId": "com.jjh1232.vfilemanage",
    "productName": "VFilemanage",
    "directories": {
      "output": "release",
      "buildResources": "buildassets"
    },
    "files": [
      "main.js",
      "preload.js",
      "setting.js",
      "appname.js",
      "handler/**/*",
      "nodeDatabase/**/*",
      "dist/**/*",
      "addon/build/Release/myaddon.node",
      "!**/*.map"
    ],
    "asarUnpack": [
      "addon/build/Release/myaddon.node",
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip",
        "portable"
      ],
      "icon": "buildassets/icon.ico"
    },
    "portable": {
      "artifactName": "VFilemanage-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "VFilemanage",
      "artifactName": "VFilemanage-${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@viselect/react": "^3.9.0",
    "bindings": "^1.5.0",
    "conf": "^10.2.0",
    "electron-store": "^8.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sqlite3": "^5.1.7",
    "styled-components": "^6.3.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "assert": "^2.1.0",
    "concurrently": "^9.2.1",
    "crypto-browserify": "^3.12.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "events": "^3.3.0",
    "node-gyp": "^12.2.0",
    "os-browserify": "^0.3.0",
    "parcel": "^2.16.4",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "wait-on": "^9.0.3"
  }
}
