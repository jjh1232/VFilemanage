{
  "name": "react-parcel",
  "version": "1.0.0",
  "main": "main.js",
  "targets": {
    "main": false
  },
  "scripts": {
    "rebuild-addon": "powershell -Command \"cd addon; node-gyp clean; node-gyp rebuild\"",
    "start": "parcel index.html",
    "build-addon": "cd addon && node-gyp rebuild",
    "build": "parcel build index.html",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:1234 && electron .\"",
    "electron": "electron ."
  },
